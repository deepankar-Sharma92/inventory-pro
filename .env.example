# Copy this file to .env in the project root before running docker compose.
# `docker compose` automatically loads a root-level .env file — nothing here
# is a real credential, these are just configuration knobs.

# ---- Backend (FastAPI) ----
BACKEND_PORT=8001
APP_ENV=production
CORS_ORIGINS=http://localhost:5173
ENABLE_DOCS=true

# ---- Frontend (React + nginx) ----
FRONTEND_PORT=5173
# Must match backend host/port as reachable from the *browser*
VITE_API_URL=http://localhost:8001
