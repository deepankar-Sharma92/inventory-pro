# Copy this file to .env and adjust values as needed.
# Docker Compose automatically loads a root-level .env file.

# Port the FastAPI app listens on inside the container
BACKEND_PORT=8001

# development | production — production hides interactive docs unless
# ENABLE_DOCS is explicitly set to true
APP_ENV=production

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Whether /docs and /redoc are exposed
ENABLE_DOCS=true
